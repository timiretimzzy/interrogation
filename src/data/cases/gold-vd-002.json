  "briefing": {
    "hook": "At 4:50 AM the research station on Harrow Inlet reported that its lead marine scientist, Dr. Vera Lindqvist, had vanished from a locked cabin. A torn note, an overturned chair, and her phone left on the table suggested a struggle.",
    "context": "Vera had been leading a controversial study funded by a private partner, Adrian Voss, whose data practices she had recently begun to question. The station is small, remote, and reachable only by boat.",
    "tension": "A missing person in a locked room reads like abduction. But the only person who could have taken her is also the one who appears to have staged the scene — and no one is certain which.",
    "objective": "Determine whether Vera was taken, whether she left on her own, and if so, why she would make herself disappear."
  },
  "playerRules": {
    "investigationActions": 16,
    "switchCharacterIsFree": true,
    "notebookReviewIsFree": true,
    "evidenceReviewIsFree": true,
    "theoryBuildingIsFree": true,
    "accusationAvailableAtAnyTime": true,
    "externalKnowledgeRequired": false,
    "runtimeLLMRequired": false
  },
  "truth": {
    "incident": "Vera staged her own disappearance. She had discovered that Adrian Voss was falsifying the research data to secure a lucrative renewal, and that she was being positioned to co-sign the fraudulent results. Rather than blow the whistle and be blamed, she arranged her own vanishing: withdrew funds under a second identity she had quietly built, staged a struggle in the cabin, took her own boat out, scuttled it, and slipped away by a service route she had pre-arranged.",
    "culpritId": "vera",
    "whatHappened": "Vera left under her own power after staging the scene. She used a decoy phone, a second identity, and a pre-planned exit route. She intended to surface once the fraudulent study could no longer be pinned on her.",
    "motive": "To escape being coerced into co-signing falsified research and to expose Adrian without becoming the scapegoat.",
    "method": "Second identity, advance cash withdrawal, staged struggle, self-scuttled boat, pre-arranged land route.",
    "centralTwist": "The apparent victim of an abduction is the author of her own disappearance.",
    "finalTruth": "There was no abduction. Vera left deliberately, and the 'struggle' was a prop.",
    "timeline": [
      {
        "time": "3 weeks prior",
        "eventId": "T001",
        "description": "Vera opens a second identity and a separate account."
      },
      {
        "time": "10 days prior",
        "eventId": "T002",
        "description": "Vera flags anomalies in Adrian's dataset internally."
      },
      {
        "time": "2 days prior",
        "eventId": "T003",
        "description": "Vera withdraws a large cash sum under the second identity."
      },
      {
        "time": "21:00",
        "eventId": "T004",
        "description": "Vera tells Mateo she is 'taking a walk to think'."
      },
      {
        "time": "02:10",
        "eventId": "T005",
        "description": "Boathouse log shows Vera's boat leaving under its own power."
      },
      {
        "time": "04:40",
        "eventId": "T006",
        "description": "The same boat is found scuttled, empty, near the inlet mouth."
      },
      {
        "time": "04:50",
        "eventId": "T007",
        "description": "Sofia finds the cabin: torn note, overturned chair, decoy phone."
      }
    ],
    "criticalFacts": [
      "Vera staged her own disappearance rather than being taken.",
      "The struggle scene was arranged with props, not a real fight.",
      "Vera held a second identity and had withdrawn cash in advance.",
      "Vera had discovered Adrian falsifying the research and was being coerced into covering it.",
      "Vera left on her own boat, which she later scuttled herself.",
      "The phone left behind was a deactivated decoy, not her active device."
    ],
    "importantSecondaryTruths": [
      "Mateo suspected Vera was planning something but said nothing out of loyalty.",
      "Adrian's panic was about the fraud being exposed, not about Vera's safety.",
      "Sofia assumed the worst because the scene looked like a crime."
    ]
  },
